{
  "entities": {
    "SharedAsset": {
      "title": "SharedAsset",
      "description": "Shared organizational signature or stamp with remembered position and size preferences, accessible by team members without login",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique ID of the asset"
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Display name of the signature or stamp"
        },
        "type": {
          "type": "string",
          "enum": ["signature", "stamp", "image"],
          "description": "Type of asset"
        },
        "imageUrl": {
          "type": "string",
          "description": "Image data URL of the signature or stamp"
        },
        "department": {
          "type": "string",
          "maxLength": 50,
          "description": "Department or owner name within organization"
        },
        "width": {
          "type": "number",
          "description": "Last remembered pixel width"
        },
        "height": {
          "type": "number",
          "description": "Last remembered pixel height"
        },
        "rotation": {
          "type": "number",
          "description": "Last remembered rotation angle in degrees"
        },
        "opacity": {
          "type": "number",
          "description": "Last remembered opacity 0 to 1"
        },
        "blendMode": {
          "type": "string",
          "enum": ["normal", "multiply", "darken"],
          "description": "Last remembered blend mode"
        },
        "relativeX": {
          "type": "number",
          "description": "Proportional horizontal placement 0 to 1"
        },
        "relativeY": {
          "type": "number",
          "description": "Proportional vertical placement 0 to 1"
        },
        "relativeWidth": {
          "type": "number",
          "description": "Proportional width relative to document width"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["name", "type", "imageUrl", "width", "height", "relativeX", "relativeY", "relativeWidth"]
    }
  },
  "firestore": {
    "/shared_assets/{assetId}": {
      "schema": "SharedAsset",
      "description": "Collection of shared organizational signatures and stamps synced in real-time across company devices"
    }
  }
}
